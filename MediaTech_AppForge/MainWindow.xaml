<Window x:Class="MediaTech_AppForge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Média-Tech"
        Height="720" Width="1200" MinHeight="500" MinWidth="940"
        FontFamily="Segoe UI" Background="{StaticResource PageBg}">

    <Grid Background="{StaticResource PageBg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*" MinWidth="360"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBg}"
                BorderBrush="{StaticResource Divider}" BorderThickness="0,0,1,0">
            <Grid Margin="18,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock FontSize="19" FontWeight="Bold">
                        <Run Text="Média-" Foreground="{StaticResource TextPrimary}"/>
                        <Run Text="Tech" Foreground="{StaticResource Accent}"/>
                    </TextBlock>
                    <TextBlock Text="Médiathèque numérique" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- NAVIGATION (sélection posée dans le code-behind, pas ici) -->
                <StackPanel Grid.Row="2">
                    <RadioButton x:Name="NavAccueil"       Content="Accueil"       Tag="&#8962;"   GroupName="Nav" Style="{StaticResource NavButton}" Click="Nav_Click"/>
                    <RadioButton x:Name="NavCatalogue"     Content="Catalogue"     Tag="&#9638;"   GroupName="Nav" Style="{StaticResource NavButton}" Click="Nav_Click"/>
                    <RadioButton x:Name="NavEmprunts"      Content="Mes emprunts"  Tag="&#128214;" GroupName="Nav" Style="{StaticResource NavButton}" Click="Nav_Click"/>
                    <RadioButton x:Name="NavNotifications" Content="Notifications" Tag="&#128276;" GroupName="Nav" Style="{StaticResource NavButton}" Click="Nav_Click"/>

                    <TextBlock x:Name="AdminHeader" Text="ADMINISTRATION" Foreground="{StaticResource TextMuted}"
                               FontSize="11" FontWeight="SemiBold" Margin="10,20,0,6" Visibility="Collapsed"/>
                    <RadioButton x:Name="NavGestion" Content="Gestion des contenus" Tag="&#9881;" GroupName="Nav"
                                 Style="{StaticResource NavButton}" Click="Nav_Click" Visibility="Collapsed"/>
                </StackPanel>

                <!-- PROFIL -->
                <Border Grid.Row="4" BorderBrush="{StaticResource Divider}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                    <Grid>
                        <!-- Invité -->
                        <StackPanel x:Name="GuestPanel">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="32" Height="32" Fill="{StaticResource AccentSoftBg}"/>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Invité" Foreground="{StaticResource TextPrimary}" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="Consultation seule" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                            <Button Content="Se connecter" Style="{StaticResource PrimaryButton}" Margin="0,12,0,0" Click="Login_Click"/>
                        </StackPanel>

                        <!-- Connecté -->
                        <StackPanel x:Name="UserPanel" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <Grid>
                                    <Ellipse Width="32" Height="32" Fill="{StaticResource AccentSoftBg}"/>
                                    <TextBlock x:Name="AvatarInitial" Foreground="{StaticResource Accent}" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="UserNameText" Foreground="{StaticResource TextPrimary}" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="UserRoleText" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                            <Button Content="Se déconnecter" Style="{StaticResource GhostButton}" Margin="0,12,0,0" Click="Logout_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- CONTENU : la page affichée change selon la navigation -->
        <ContentControl x:Name="MainContent" Grid.Column="1"/>
    </Grid>
</Window>
