<UserControl x:Class="MediaTech_AppForge.Views.GestionUsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="900" Margin="32,8,32,24">

            <!-- FORMULAIRE : ajout ou modification -->
            <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}"
                    BorderThickness="1" CornerRadius="12" Padding="20,16" Margin="0,8,0,16">
                <StackPanel>
                    <TextBlock x:Name="FormTitle" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>

                    <TextBlock Text="Identifiant *" Style="{StaticResource FieldLabel}"/>
                    <Border Style="{StaticResource FieldBorder}">
                        <TextBox x:Name="UsernameBox" Style="{StaticResource FieldTextBox}" MaxLength="50"/>
                    </Border>

                    <TextBlock Text="Mot de passe" Style="{StaticResource FieldLabel}"/>
                    <Border Style="{StaticResource FieldBorder}">
                        <PasswordBox x:Name="PasswordBox" Background="Transparent" BorderThickness="0" FontSize="14"
                                     Foreground="{StaticResource TextPrimary}" CaretBrush="{StaticResource TextPrimary}"/>
                    </Border>
                    <TextBlock x:Name="PasswordHint" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,6,0,0"/>

                    <TextBlock Text="Rôle" Style="{StaticResource FieldLabel}"/>
                    <CheckBox x:Name="AdminCheck" Content="Administrateur" Style="{StaticResource ChipCheck}" HorizontalAlignment="Left"/>

                    <TextBlock Text="État du compte" Style="{StaticResource FieldLabel}"/>
                    <WrapPanel>
                        <RadioButton x:Name="EtatActif" Content="Actif" GroupName="UserEtat" IsChecked="True" Style="{StaticResource ChipButton}"/>
                        <RadioButton x:Name="EtatSuspendu" Content="Suspendu" GroupName="UserEtat" Style="{StaticResource ChipButton}"/>
                        <RadioButton x:Name="EtatBanni" Content="Banni" GroupName="UserEtat" Style="{StaticResource ChipButton}"/>
                    </WrapPanel>

                    <TextBlock x:Name="FormError" Foreground="{StaticResource Danger}" FontSize="12"
                               TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click"/>
                        <Button x:Name="CancelButton" Content="Annuler" Style="{StaticResource GhostButton}"
                                Margin="10,0,0,0" Visibility="Collapsed" Click="Cancel_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock x:Name="StatusText" Text="Chargement…" Foreground="{StaticResource TextMuted}" FontSize="14"/>
            <TextBlock x:Name="ActionMessage" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,12" Visibility="Collapsed"/>

            <ItemsControl x:Name="UserList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ListCard}" Cursor="Arrow">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Username}" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0"/>
                                </StackPanel>

                                <Border Grid.Column="1" VerticalAlignment="Center" Margin="12,0,12,0">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource CountBadge}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EtatBadge}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding EtatBadge}" Foreground="{StaticResource Danger}" FontSize="12"/>
                                </Border>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Modifier" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="Edit_Click"/>
                                    <Button Content="Supprimer" Style="{StaticResource GhostButton}"
                                            Foreground="{StaticResource Danger}" Click="Delete_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
