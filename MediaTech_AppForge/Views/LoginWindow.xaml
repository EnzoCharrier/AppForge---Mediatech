<Window x:Class="MediaTech_AppForge.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connexion" Width="400" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" Background="{StaticResource PageBg}">
    <StackPanel Margin="32,28">
        <TextBlock FontSize="22" FontWeight="Bold">
            <Run Text="Média-" Foreground="{StaticResource TextPrimary}"/><Run Text="Tech" Foreground="{StaticResource Accent}"/>
        </TextBlock>
        <TextBlock Text="Connectez-vous pour emprunter et suivre vos emprunts."
                   Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,24"/>

        <TextBlock Text="Identifiant" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,6"/>
        <Border Style="{StaticResource FieldBorder}">
            <TextBox x:Name="UsernameBox" Background="Transparent" BorderThickness="0" FontSize="14"
                     Foreground="{StaticResource TextPrimary}" CaretBrush="{StaticResource TextPrimary}"/>
        </Border>

        <TextBlock Text="Mot de passe" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,16,0,6"/>
        <Border Style="{StaticResource FieldBorder}">
            <PasswordBox x:Name="PasswordBox" Background="Transparent" BorderThickness="0" FontSize="14"
                         Foreground="{StaticResource TextPrimary}" CaretBrush="{StaticResource TextPrimary}"/>
        </Border>

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" FontSize="12"
                   TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>

        <Button x:Name="LoginButton" Content="Se connecter" IsDefault="True"
                Style="{StaticResource PrimaryButton}" Margin="0,24,0,0" Click="Login_Click"/>
        <Button Content="Continuer en invité" IsCancel="True"
                Style="{StaticResource GhostButton}" Margin="0,10,0,0"/>
    </StackPanel>
</Window>
