<UserControl x:Class="MediaTech_AppForge.Views.GestionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" MaxWidth="900" Margin="32,24,32,0">
            <TextBlock FontSize="13">
                <Run Text="Média-Tech" Foreground="{StaticResource TextMuted}"/>
                <Run Text=" / " Foreground="{StaticResource TextMuted}"/>
                <Run Text="Administration" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/>
            </TextBlock>
            <TextBlock Text="Gestion des contenus" FontSize="26" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimary}" Margin="0,8,0,16"/>

            <WrapPanel>
                <RadioButton x:Name="TabMedias" Content="Médias" GroupName="GestionTab" IsChecked="True"
                             Style="{StaticResource ChipButton}" Click="Tab_Click"/>
                <RadioButton x:Name="TabAuteurs" Content="Auteurs" GroupName="GestionTab"
                             Style="{StaticResource ChipButton}" Click="Tab_Click"/>
                <RadioButton x:Name="TabEditeurs" Content="Éditeurs" GroupName="GestionTab"
                             Style="{StaticResource ChipButton}" Click="Tab_Click"/>
                <RadioButton x:Name="TabGenres" Content="Genres" GroupName="GestionTab"
                             Style="{StaticResource ChipButton}" Click="Tab_Click"/>
                <RadioButton x:Name="TabUtilisateurs" Content="Utilisateurs" GroupName="GestionTab"
                             Style="{StaticResource ChipButton}" Click="Tab_Click"/>
            </WrapPanel>
        </StackPanel>

        <ContentControl x:Name="SectionHost" Grid.Row="1"/>
    </Grid>
</UserControl>
