<UserControl x:Class="MediaTech_AppForge.Views.AccueilView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:MediaTech_AppForge.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="960" Margin="32,28,32,40">

            <!-- ============ BANDEAU D'ACCUEIL ============ -->
            <Border CornerRadius="20" BorderThickness="1" BorderBrush="#FF2A1F4D" ClipToBounds="True" Padding="40,36">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF1E1240" Offset="0"/>
                        <GradientStop Color="#FF110D1F" Offset="0.55"/>
                        <GradientStop Color="#FF0A0A0A" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <!-- halos lumineux -->
                    <Ellipse Width="360" Height="360" Fill="{StaticResource Accent}" Opacity="0.28"
                             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-190,-120,0">
                        <Ellipse.Effect><BlurEffect Radius="90"/></Ellipse.Effect>
                    </Ellipse>
                    <Ellipse Width="240" Height="240" Fill="#FF2563EB" Opacity="0.18"
                             HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-110,0,0,-150">
                        <Ellipse.Effect><BlurEffect Radius="80"/></Ellipse.Effect>
                    </Ellipse>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <v:LogoMark Width="44" Height="44"/>
                                <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" FontSize="20" FontWeight="Bold">
                                    <Run Text="Média-" Foreground="White"/><Run Text="Tech" Foreground="{StaticResource Accent}"/>
                                </TextBlock>
                            </StackPanel>

                            <TextBlock x:Name="GreetingText" Foreground="#FFC4B5FD" FontSize="13" FontWeight="SemiBold" Margin="0,26,0,0"/>

                            <TextBlock FontSize="40" FontWeight="Bold" TextWrapping="Wrap" Margin="0,6,0,0">
                                <Run Text="Lisez. " Foreground="White"/><Run Text="Regardez. " Foreground="#FFA78BFA"/><Run Text="Écoutez." Foreground="White"/>
                            </TextBlock>

                            <TextBlock Text="Livres, magazines, films et musique : tout le catalogue de la médiathèque, à portée de clic."
                                       Foreground="{StaticResource TextSecondary}" FontSize="15" TextWrapping="Wrap"
                                       MaxWidth="440" HorizontalAlignment="Left" Margin="0,14,0,0"/>

                            <StackPanel Orientation="Horizontal" Margin="0,26,0,0">
                                <Button Content="Explorer le catalogue  &#8594;" Style="{StaticResource PrimaryButton}" Click="Catalogue_Click"/>
                                <Button x:Name="LoginButton" Content="Se connecter" Style="{StaticResource GhostButton}"
                                        Margin="10,0,0,0" Visibility="Collapsed" Click="Login_Click"/>
                            </StackPanel>

                            <Border x:Name="TotalBadge" Style="{StaticResource CountBadge}" HorizontalAlignment="Left"
                                    Margin="0,20,0,0" Visibility="Collapsed">
                                <TextBlock x:Name="TotalText" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                            </Border>
                        </StackPanel>

                        <!-- composition de couvertures -->
                        <Canvas Grid.Column="1" Width="300" Height="250" Margin="28,0,0,0" VerticalAlignment="Center">

                            <Border Canvas.Left="6" Canvas.Top="56" Width="118" Height="168" CornerRadius="14" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform><RotateTransform Angle="-13"/></Border.RenderTransform>
                                <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.45" Color="Black"/></Border.Effect>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FF8B5CF6" Offset="0"/><GradientStop Color="#FF4C1D95" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <TextBlock Text="&#128214;" FontSize="44" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-20,0,0"/>
                                    <Border Height="6" Width="64" CornerRadius="3" Background="#59FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="14,0,0,30"/>
                                    <Border Height="6" Width="38" CornerRadius="3" Background="#33FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="14,0,0,16"/>
                                </Grid>
                            </Border>

                            <Border Canvas.Left="172" Canvas.Top="48" Width="118" Height="168" CornerRadius="14" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform><RotateTransform Angle="12"/></Border.RenderTransform>
                                <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.45" Color="Black"/></Border.Effect>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FF38BDF8" Offset="0"/><GradientStop Color="#FF1D4ED8" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <TextBlock Text="&#127916;" FontSize="44" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-20,0,0"/>
                                    <Border Height="6" Width="64" CornerRadius="3" Background="#59FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="14,0,0,30"/>
                                    <Border Height="6" Width="38" CornerRadius="3" Background="#33FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="14,0,0,16"/>
                                </Grid>
                            </Border>

                            <Border Canvas.Left="88" Canvas.Top="14" Width="124" Height="176" CornerRadius="14" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform><RotateTransform Angle="-2"/></Border.RenderTransform>
                                <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.55" Color="Black"/></Border.Effect>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FF34D399" Offset="0"/><GradientStop Color="#FF047857" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <TextBlock Text="&#128191;" FontSize="48" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-20,0,0"/>
                                    <Border Height="6" Width="70" CornerRadius="3" Background="#59FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="14,0,0,32"/>
                                    <Border Height="6" Width="42" CornerRadius="3" Background="#33FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="14,0,0,17"/>
                                </Grid>
                            </Border>
                        </Canvas>
                    </Grid>
                </Grid>
            </Border>

            <!-- ============ CE QUE LA MÉDIATHÈQUE OFFRE ============ -->
            <UniformGrid Columns="3" Margin="0,30,-16,0">
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="&#128218;" FontSize="24"/>
                    <TextBlock Text="Un catalogue complet" Foreground="{StaticResource TextPrimary}" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,0"/>
                    <TextBlock Text="Livres, magazines, DVD et CD réunis au même endroit."
                               Foreground="{StaticResource TextMuted}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="&#128260;" FontSize="24"/>
                    <TextBlock Text="Physique ou numérique" Foreground="{StaticResource TextPrimary}" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,0"/>
                    <TextBlock Text="Empruntez l'exemplaire en rayon ou sa version numérique."
                               Foreground="{StaticResource TextMuted}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="&#128276;" FontSize="24"/>
                    <TextBlock Text="Toujours informé" Foreground="{StaticResource TextPrimary}" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,0"/>
                    <TextBlock Text="Rappels de retour et nouveautés, directement dans l'application."
                               Foreground="{StaticResource TextMuted}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </UniformGrid>

            <!-- ============ A DECOUVRIR ============ -->
            <StackPanel x:Name="ShowcaseSection" Margin="0,38,0,0" Visibility="Collapsed">
                <Grid Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="À découvrir" Foreground="{StaticResource TextPrimary}" FontSize="22" FontWeight="Bold"/>
                        <TextBlock Text="Les derniers ajouts au catalogue" Foreground="{StaticResource TextMuted}" FontSize="13" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Content="Tout le catalogue  &#8594;" Style="{StaticResource LinkButton}"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="Catalogue_Click"/>
                </Grid>
                <WrapPanel x:Name="ShowcasePanel"/>
            </StackPanel>

            <TextBlock x:Name="StatusText" Foreground="{StaticResource TextMuted}" FontSize="13" Margin="0,24,0,0" Visibility="Collapsed"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
