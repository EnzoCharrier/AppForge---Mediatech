<UserControl x:Class="MediaTech_AppForge.Views.MediaDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="760" Margin="32,24">

            <Button Content="&#8592;  Retour" Style="{StaticResource LinkButton}"
                    HorizontalAlignment="Left" Click="Back_Click"/>

            <TextBlock x:Name="KindText" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="SemiBold" Margin="0,18,0,0"/>
            <TextBlock x:Name="TitleText" Foreground="{StaticResource TextPrimary}" FontSize="28" FontWeight="Bold"
                       TextWrapping="Wrap" Margin="0,4,0,0"/>
            <TextBlock x:Name="AuthorText" Foreground="{StaticResource TextSecondary}" FontSize="15" Margin="0,4,0,0"
                       Visibility="Collapsed"/>

            <TextBlock x:Name="StatusText" Text="Chargement…" Foreground="{StaticResource TextMuted}" FontSize="14" Margin="0,16,0,0"/>

            <StackPanel x:Name="BodyPanel" Visibility="Collapsed">

                <ItemsControl x:Name="GenresList" Margin="0,16,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CountBadge}" Margin="0,0,8,8">
                                <TextBlock Text="{Binding}" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}"
                        BorderThickness="1" CornerRadius="12" Padding="20,8" Margin="0,8,0,0">
                    <ItemsControl x:Name="FieldsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextMuted}" FontSize="13"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{StaticResource TextPrimary}"
                                               FontSize="14" TextWrapping="Wrap"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <TextBlock x:Name="StockText" Foreground="{StaticResource TextSecondary}" FontSize="14" Margin="0,20,0,0"/>

                <StackPanel Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="LoginButton" Content="Se connecter pour emprunter"
                                Style="{StaticResource PrimaryButton}" Click="Login_Click"/>
                        <Button x:Name="PhysicalButton" Content="Emprunter l'exemplaire"
                                Style="{StaticResource PrimaryButton}" Click="Borrow_Click"
                                Margin="0,0,10,0" Visibility="Collapsed"/>
                        <Button x:Name="DigitalButton" Content="Emprunter en numérique"
                                Style="{StaticResource GhostButton}" Click="Borrow_Click" Visibility="Collapsed"/>
                    </StackPanel>
                    <TextBlock x:Name="BorrowHint" Foreground="{StaticResource TextMuted}" FontSize="12"
                               TextWrapping="Wrap" Margin="0,10,0,0"/>
                    <TextBlock x:Name="BorrowMessage" FontSize="13" TextWrapping="Wrap"
                               Margin="0,8,0,0" Visibility="Collapsed"/>
                </StackPanel>

                <StackPanel x:Name="ResumePanel" Margin="0,28,0,0" Visibility="Collapsed">
                    <TextBlock Text="Résumé" Foreground="{StaticResource TextPrimary}" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ResumeText" Foreground="{StaticResource TextSecondary}" FontSize="14"
                               TextWrapping="Wrap" LineHeight="22" Margin="0,8,0,0"/>
                </StackPanel>

                <StackPanel x:Name="PistesPanel" Margin="0,28,0,0" Visibility="Collapsed">
                    <TextBlock Text="Pistes" Foreground="{StaticResource TextPrimary}" FontSize="17" FontWeight="SemiBold"/>
                    <ItemsControl x:Name="PistesList" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Numero}" Foreground="{StaticResource TextMuted}" FontSize="13"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Titre}" Foreground="{StaticResource TextPrimary}" FontSize="14"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Duree}" Foreground="{StaticResource TextMuted}" FontSize="13"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
