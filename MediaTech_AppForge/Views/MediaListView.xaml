<UserControl x:Class="MediaTech_AppForge.Views.MediaListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="900" Margin="32,24">

            <Button Content="&#8592;  Catalogue" Style="{StaticResource LinkButton}"
                    HorizontalAlignment="Left" Click="Back_Click"/>

            <Grid Margin="0,14,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                    <Border Style="{StaticResource CountBadge}" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="CountText" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                    </Border>
                </StackPanel>

                <Border Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0"
                        Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}"
                        BorderThickness="1" CornerRadius="8" Padding="12,8" MinWidth="280">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#128269;" Foreground="{StaticResource TextMuted}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBox x:Name="SearchInput" Style="{StaticResource SearchBox}" Width="230"
                                 TextChanged="SearchInput_TextChanged"/>
                    </StackPanel>
                </Border>
            </Grid>

            <WrapPanel x:Name="GenreChips" Margin="0,0,0,8"/>

            <TextBlock x:Name="StatusText" Text="Chargement…" Foreground="{StaticResource TextMuted}" FontSize="14" Margin="0,8,0,0"/>
            <TextBlock x:Name="EmptyText" Text="Aucun résultat." Foreground="{StaticResource TextMuted}"
                       FontSize="14" Margin="0,8,0,0" Visibility="Collapsed"/>

            <ItemsControl x:Name="ResultsList" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ListCard}" MouseLeftButtonUp="Row_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Titre}" FontSize="16" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Subtitle}" FontSize="13" Foreground="{StaticResource TextSecondary}"
                                               Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding GenresText}" FontSize="12" Foreground="{StaticResource TextMuted}"
                                               Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Border Grid.Column="1" Style="{StaticResource CountBadge}" VerticalAlignment="Top" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding StockText}" FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasStock}" Value="False">
                                                        <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
