<UserControl x:Class="MediaTech_AppForge.Views.GestionMediasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="900" Margin="32,8,32,24">

            <Grid Margin="0,8,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}"
                        BorderThickness="1" CornerRadius="8" Padding="12,8" MinWidth="320">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#128269;" Foreground="{StaticResource TextMuted}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBox x:Name="SearchInput" Style="{StaticResource SearchBox}" Width="270"
                                 TextChanged="SearchInput_TextChanged"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CountBadge}" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="CountText" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                </Border>

                <Button Grid.Column="3" Content="+  Nouveau média" Style="{StaticResource PrimaryButton}" Click="New_Click"/>
            </Grid>

            <TextBlock x:Name="StatusText" Text="Chargement…" Foreground="{StaticResource TextMuted}" FontSize="14"/>
            <TextBlock x:Name="ActionMessage" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,12" Visibility="Collapsed"/>
            <TextBlock x:Name="EmptyText" Text="Aucun média." Foreground="{StaticResource TextMuted}" FontSize="14"
                       Visibility="Collapsed"/>

            <ItemsControl x:Name="MediaList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ListCard}" Cursor="Arrow">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Titre}" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{StaticResource TextSecondary}"
                                               Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <Border Grid.Column="1" Style="{StaticResource CountBadge}" VerticalAlignment="Center" Margin="12,0,12,0">
                                    <TextBlock Text="{Binding StockText}" FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasStock}" Value="False">
                                                        <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Modifier" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="Edit_Click"/>
                                    <Button Content="Supprimer" Style="{StaticResource GhostButton}"
                                            Foreground="{StaticResource Danger}" Click="Delete_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
