<Window x:Class="MediaTech_AppForge.Views.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirmation" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" Background="{StaticResource PageBg}">
    <StackPanel Margin="28,24">
        <TextBlock x:Name="TitleText" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap"/>
        <TextBlock x:Name="MessageText" FontSize="13" Foreground="{StaticResource TextSecondary}"
                   TextWrapping="Wrap" Margin="0,10,0,24"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Annuler" IsCancel="True" Style="{StaticResource GhostButton}" Margin="0,0,10,0"/>
            <Button x:Name="ConfirmButton" Style="{StaticResource DangerButton}" Click="Confirm_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
