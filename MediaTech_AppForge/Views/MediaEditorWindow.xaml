<Window x:Class="MediaTech_AppForge.Views.MediaEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MediaTech_AppForge.Views"
        Title="Média" Width="620" Height="740" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" Background="{StaticResource PageBg}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="32,28,32,20">
                <TextBlock x:Name="HeaderText" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                <TextBlock x:Name="StatusText" Text="Chargement…" Foreground="{StaticResource TextMuted}" FontSize="14" Margin="0,12,0,0"/>

                <StackPanel x:Name="FormPanel" Visibility="Collapsed">

                    <TextBlock Text="Type" Style="{StaticResource FieldLabel}"/>
                    <WrapPanel x:Name="TypeChips"/>
                    <TextBlock x:Name="TypeFixedText" Foreground="{StaticResource TextPrimary}" FontSize="14" Visibility="Collapsed"/>

                    <TextBlock Text="Titre *" Style="{StaticResource FieldLabel}"/>
                    <Border Style="{StaticResource FieldBorder}">
                        <TextBox x:Name="TitreBox" Style="{StaticResource FieldTextBox}" MaxLength="150"/>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Date de sortie (jj/mm/aaaa)" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource FieldBorder}">
                                <TextBox x:Name="DateBox" Style="{StaticResource FieldTextBox}" MaxLength="10"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Stock (exemplaires physiques) *" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource FieldBorder}">
                                <TextBox x:Name="StockBox" Style="{StaticResource FieldTextBox}" Text="0" MaxLength="6"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Éditeur *" Style="{StaticResource FieldLabel}"/>
                    <local:SuggestBox x:Name="EditeurBox" MaxLength="100"/>

                    <TextBlock Text="Auteur" Style="{StaticResource FieldLabel}"/>
                    <local:SuggestBox x:Name="AuteurBox" MaxLength="100"/>
                    <TextBlock Text="Un nom inconnu sera créé à l'enregistrement. Sinon, cliquez sur une suggestion."
                               Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>

                    <TextBlock Text="Genres" Style="{StaticResource FieldLabel}"/>
                    <WrapPanel x:Name="GenreChips"/>
                    <TextBlock x:Name="GenreEmpty" Text="Aucun genre défini pour le moment."
                               Foreground="{StaticResource TextMuted}" FontSize="12" Visibility="Collapsed"/>

                    <!-- LIVRE -->
                    <StackPanel x:Name="LivrePanel">
                        <TextBlock Text="Nombre de pages" Style="{StaticResource FieldLabel}"/>
                        <Border Style="{StaticResource FieldBorder}">
                            <TextBox x:Name="LivrePagesBox" Style="{StaticResource FieldTextBox}" MaxLength="6"/>
                        </Border>
                        <TextBlock Text="Résumé" Style="{StaticResource FieldLabel}"/>
                        <Border Style="{StaticResource FieldBorder}">
                            <TextBox x:Name="ResumeBox" Style="{StaticResource FieldTextBox}" AcceptsReturn="True"
                                     TextWrapping="Wrap" MinHeight="90" VerticalScrollBarVisibility="Auto"/>
                        </Border>
                    </StackPanel>

                    <!-- MAGAZINE -->
                    <StackPanel x:Name="MagazinePanel" Visibility="Collapsed">
                        <TextBlock Text="Numéro" Style="{StaticResource FieldLabel}"/>
                        <Border Style="{StaticResource FieldBorder}">
                            <TextBox x:Name="MagNumeroBox" Style="{StaticResource FieldTextBox}" MaxLength="6"/>
                        </Border>
                        <TextBlock Text="Nombre de pages" Style="{StaticResource FieldLabel}"/>
                        <Border Style="{StaticResource FieldBorder}">
                            <TextBox x:Name="MagPagesBox" Style="{StaticResource FieldTextBox}" MaxLength="6"/>
                        </Border>
                    </StackPanel>

                    <!-- DVD -->
                    <StackPanel x:Name="DvdPanel" Visibility="Collapsed">
                        <TextBlock Text="Durée (h:mm, ex. 2:49)" Style="{StaticResource FieldLabel}"/>
                        <Border Style="{StaticResource FieldBorder}">
                            <TextBox x:Name="DvdDureeBox" Style="{StaticResource FieldTextBox}" MaxLength="8"/>
                        </Border>
                    </StackPanel>

                    <!-- CD -->
                    <StackPanel x:Name="CdPanel" Visibility="Collapsed">
                        <TextBlock Text="Nombre de pistes (laisser vide = nombre de lignes ci-dessous)" Style="{StaticResource FieldLabel}"/>
                        <Border Style="{StaticResource FieldBorder}">
                            <TextBox x:Name="CdCountBox" Style="{StaticResource FieldTextBox}" MaxLength="4"/>
                        </Border>
                        <TextBlock Text="Pistes (une par ligne : Titre ; m:ss)" Style="{StaticResource FieldLabel}"/>
                        <Border Style="{StaticResource FieldBorder}">
                            <TextBox x:Name="PistesBox" Style="{StaticResource FieldTextBox}" AcceptsReturn="True"
                                     TextWrapping="NoWrap" MinHeight="110" VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"/>
                        </Border>
                    </StackPanel>

                    <CheckBox x:Name="NotifyCheck" Content="Notifier les membres de cet ajout" IsChecked="True"
                              Style="{StaticResource ChipCheck}" HorizontalAlignment="Left" Margin="0,20,0,0"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" BorderBrush="{StaticResource Divider}" BorderThickness="0,1,0,0" Padding="32,14">
            <StackPanel>
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" FontSize="12"
                           TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Annuler" IsCancel="True" Style="{StaticResource GhostButton}" Margin="0,0,10,0"/>
                    <Button x:Name="SaveButton" Content="Enregistrer" IsDefault="False" IsEnabled="False"
                            Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
