<Window x:Class="MediaTech_AppForge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MediaTech_AppForge"
        mc:Ignorable="d"
        Title="Média-Tech"
        Height="720"
        Width="1200"
        MinHeight="500"
        MinWidth="940"
        FontFamily="Segoe UI"
        Background="#FF0A0A0A">

    <Window.Resources>

        <!-- ===================== COULEURS ===================== -->
        <SolidColorBrush x:Key="PageBg"        Color="#FF0A0A0A"/>
        <SolidColorBrush x:Key="SidebarBg"     Color="#FF050505"/>
        <SolidColorBrush x:Key="CardBg"        Color="#FF121212"/>
        <SolidColorBrush x:Key="CardBorder"    Color="#FF262626"/>
        <SolidColorBrush x:Key="Divider"       Color="#FF232323"/>
        <SolidColorBrush x:Key="Accent"        Color="#FF8B5CF6"/>
        <SolidColorBrush x:Key="AccentSoftBg"  Color="#FF231A38"/>
        <SolidColorBrush x:Key="TextPrimary"   Color="#FFF5F5F5"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#FF9A9A9F"/>
        <SolidColorBrush x:Key="TextMuted"     Color="#FF6B6B70"/>
        <SolidColorBrush x:Key="BadgeBg"       Color="#FF181818"/>

        <!-- ===================== ICONE GENERIQUE ===================== -->
        <Style x:Key="IconText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ===================== BOUTON DE NAVIGATION ===================== -->
        <Style x:Key="NavButton" TargetType="RadioButton">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                CornerRadius="8"
                                Background="Transparent"
                                Padding="10,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Ico"
                                           Grid.Column="0"
                                           Text="{TemplateBinding Tag}"
                                           Style="{StaticResource IconText}"
                                           Foreground="{TemplateBinding Foreground}"/>
                                <ContentPresenter Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   Content="{TemplateBinding Content}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBg}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF161616"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== BADGE (compteur) ===================== -->
        <Style x:Key="CountBadge" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BadgeBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>

        <!-- ===================== CHAMP DE RECHERCHE (avec placeholder) ===================== -->
        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Tag" Value="Rechercher un titre, un auteur..."/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid Background="{TemplateBinding Background}">
                            <TextBlock x:Name="Placeholder"
                                       Text="{TemplateBinding Tag}"
                                       Foreground="{StaticResource TextMuted}"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== CARTE CATALOGUE ===================== -->
        <!-- Taille fixe (design de référence). Le bloc entier est mis à l'échelle
             globalement par un Viewbox plus bas, donc la carte grandit en largeur
             ET en hauteur en gardant ses proportions, au lieu de s'étirer à plat. -->
        <Style x:Key="CatalogCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Padding" Value="22,20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="280"/>
            <Setter Property="Height" Value="140"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid Background="{StaticResource PageBg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*" MinWidth="360"/>
        </Grid.ColumnDefinitions>

        <!-- ============================================================ -->
        <!-- SIDEBAR                                                      -->
        <!-- ============================================================ -->
        <Border Grid.Column="0"
                Background="{StaticResource SidebarBg}"
                BorderBrush="{StaticResource Divider}"
                BorderThickness="0,0,1,0">

            <Grid Margin="18,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- logo -->
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="Auto"/>
                    <!-- nav -->
                    <RowDefinition Height="*"/>
                    <!-- spacer -->
                    <RowDefinition Height="Auto"/>
                    <!-- profil -->
                </Grid.RowDefinitions>

                <!-- LOGO -->
                <StackPanel Grid.Row="0">
                    <TextBlock FontSize="19" FontWeight="Bold">
                        <Run Text="Média-" Foreground="{StaticResource TextPrimary}"/>
                        <Run Text="Tech" Foreground="{StaticResource Accent}"/>
                    </TextBlock>
                    <TextBlock Text="Médiathèque numérique"
                               Foreground="{StaticResource TextMuted}"
                               FontSize="11"
                               Margin="0,3,0,0"/>
                </StackPanel>

                <!-- NAVIGATION -->
                <StackPanel Grid.Row="2">
                    <RadioButton Content="Accueil"      Tag="&#8962;" GroupName="Nav" Style="{StaticResource NavButton}"/>
                    <RadioButton Content="Catalogue"     Tag="&#9638;" GroupName="Nav" Style="{StaticResource NavButton}" IsChecked="True"/>
                    <RadioButton Content="Mes emprunts"  Tag="&#128214;" GroupName="Nav" Style="{StaticResource NavButton}"/>
                    <RadioButton Content="Notifications" Tag="&#128276;" GroupName="Nav" Style="{StaticResource NavButton}"/>

                    <TextBlock Text="ADMINISTRATION"
                               Foreground="{StaticResource TextMuted}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Margin="10,20,0,6"/>

                    <RadioButton Content="Gestion des contenus" Tag="&#9881;" GroupName="Nav" Style="{StaticResource NavButton}"/>
                </StackPanel>

                <!-- PROFIL (bas de sidebar) -->
                <Border Grid.Row="4"
                        BorderBrush="{StaticResource Divider}"
                        BorderThickness="0,1,0,0"
                        Padding="0,14,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="32" Height="32" Fill="{StaticResource AccentSoftBg}"/>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Camille Rey" Foreground="{StaticResource TextPrimary}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="Membre — Profil" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </Grid>
        </Border>

        <!-- ============================================================ -->
        <!-- CONTENU PRINCIPAL                                             -->
        <!-- Le bloc (en-tête + cartes) a une taille de référence fixe      -->
        <!-- (632px de large). Le Viewbox le met à l'échelle UNIFORMEMENT   -->
        <!-- (largeur ET hauteur ensemble, mêmes proportions) selon         -->
        <!-- l'espace dispo : petit en fenêtre réduite, grand en plein      -->
        <!-- écran - exactement comme sur les deux captures de référence.  -->
        <!-- StretchDirection="UpOnly" empêche de rétrécir sous la taille   -->
        <!-- de référence (jamais moins lisible que le design d'origine).   -->
        <!-- ============================================================ -->
        <ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="32,20,32,20"
                      HorizontalContentAlignment="Center"
                      VerticalContentAlignment="Top">

            <Viewbox Stretch="Uniform" StretchDirection="UpOnly">
                <StackPanel Width="632">

                    <!-- EN-TETE -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="220"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock FontSize="13">
                            <Run Text="Média-Tech" Foreground="{StaticResource TextMuted}"/>
                            <Run Text=" / " Foreground="{StaticResource TextMuted}"/>
                            <Run Text="Catalogue" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/>
                            </TextBlock>
                            <TextBlock Text="Que souhaitez-vous emprunter ?"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0"/>
                        </StackPanel>

                        <Border Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="16,0,0,0"
                            Background="{StaticResource CardBg}"
                            BorderBrush="{StaticResource CardBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,8"
                            MinWidth="220">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#128269;" Foreground="{StaticResource TextMuted}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBox Style="{StaticResource SearchBox}" Width="160"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- CARTES : WrapPanel, taille fixe -> mises à l'échelle globalement
                     par le Viewbox parent, pas étirées individuellement. -->
                    <WrapPanel Orientation="Horizontal">

                        <!-- LIVRES -->
                        <Border Style="{StaticResource CatalogCard}">
                            <Grid VerticalAlignment="Top">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="18"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="4"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#128214;" FontSize="22" Foreground="{StaticResource TextPrimary}"/>
                                    <Border Grid.Column="2" Style="{StaticResource CountBadge}">
                                        <TextBlock Text="1 240 titres" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                                    </Border>
                                </Grid>
                                <TextBlock Grid.Row="2" Text="Livres" Foreground="{StaticResource TextPrimary}" FontSize="19" FontWeight="Bold"/>
                                <TextBlock Grid.Row="4" Text="Romans, essais, bandes dessinées" Foreground="{StaticResource TextMuted}" FontSize="13" TextWrapping="Wrap"/>
                            </Grid>
                        </Border>

                        <!-- MAGAZINES -->
                        <Border Style="{StaticResource CatalogCard}">
                            <Grid VerticalAlignment="Top">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="18"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="4"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#128240;" FontSize="22" Foreground="{StaticResource TextPrimary}"/>
                                    <Border Grid.Column="2" Style="{StaticResource CountBadge}">
                                        <TextBlock Text="318 titres" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                                    </Border>
                                </Grid>
                                <TextBlock Grid.Row="2" Text="Magazines" Foreground="{StaticResource TextPrimary}" FontSize="19" FontWeight="Bold"/>
                                <TextBlock Grid.Row="4" Text="Presse et périodiques" Foreground="{StaticResource TextMuted}" FontSize="13" TextWrapping="Wrap"/>
                            </Grid>
                        </Border>

                        <!-- DVD -->
                        <Border Style="{StaticResource CatalogCard}">
                            <Grid VerticalAlignment="Top">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="18"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="4"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#127909;" FontSize="22" Foreground="{StaticResource TextPrimary}"/>
                                    <Border Grid.Column="2" Style="{StaticResource CountBadge}">
                                        <TextBlock Text="560 titres" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                                    </Border>
                                </Grid>
                                <TextBlock Grid.Row="2" Text="DVD" Foreground="{StaticResource TextPrimary}" FontSize="19" FontWeight="Bold"/>
                                <TextBlock Grid.Row="4" Text="Films et documentaires" Foreground="{StaticResource TextMuted}" FontSize="13" TextWrapping="Wrap"/>
                            </Grid>
                        </Border>

                        <!-- CD -->
                        <Border Style="{StaticResource CatalogCard}">
                            <Grid VerticalAlignment="Top">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="18"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="4"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#128191;" FontSize="22" Foreground="{StaticResource TextPrimary}"/>
                                    <Border Grid.Column="2" Style="{StaticResource CountBadge}">
                                        <TextBlock Text="742 titres" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                                    </Border>
                                </Grid>
                                <TextBlock Grid.Row="2" Text="CD" Foreground="{StaticResource TextPrimary}" FontSize="19" FontWeight="Bold"/>
                                <TextBlock Grid.Row="4" Text="Musique et livres audio" Foreground="{StaticResource TextMuted}" FontSize="13" TextWrapping="Wrap"/>
                            </Grid>
                        </Border>

                    </WrapPanel>

                </StackPanel>
            </Viewbox>
        </ScrollViewer>

    </Grid>

</Window>
